{
  "name": "meappalzheimerbussiness-tests",
  "version": "1.0.0",
  "description": "Testes para o aplicativo MeApp Alzheimer",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "detox test",
    "test:ui": "jest --testPathPattern=__tests__/ui",
    "test:validation": "jest --testPathPattern=__tests__/validation",
    "test:acceptance": "jest --testPathPattern=__tests__/acceptance"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/__tests__/setup.ts"],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{js,jsx,ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "jest-expo": "^49.0.0",
    "detox": "^20.13.5",
    "react-test-renderer": "^18.2.0",
    "@react-native-async-storage/async-storage": "^1.19.3",
    "expo-notifications": "^0.20.1"
  }
}
